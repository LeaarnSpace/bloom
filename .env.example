# Share the design cookie across bloom.ng and its subdomains (leave empty locally).
COOKIE_DOMAIN=

# Comma-separated emails / phone numbers that get the admin role on first sign-in.
ADMIN_IDENTIFIERS=

# "coming-soon" (default) shows only the pre-launch page; "full" shows the whole site.
SITE_MODE=

# Postgres used by the app at runtime. On Neon, the POOLED URL (host contains "-pooler").
# When set, waitlist sign-ups are stored in main.waitlist. Unset: kept in memory only
# (lost on restart). Also used by the database tests, which roll back and leave no rows.
# Local example: postgres://postgres@127.0.0.1:5432/bloom
DATABASE_URL=

# Migrations only (pnpm db:migrate): Neon's DIRECT URL (no "-pooler"). Not needed by the
# app. Leave empty locally, where migrations use DATABASE_URL. The Vercel–Neon
# integration sets both of these names automatically.
DATABASE_URL_UNPOOLED=

# Address the "Contact us" link emails. Unset: the link shows as plain text.
CONTACT_EMAIL=info@bloom.ng
