# Share the design cookie across bloom.ng and its subdomains (leave empty locally).
COOKIE_DOMAIN=

# Comma-separated emails / phone numbers that get the admin role on first sign-in.
ADMIN_IDENTIFIERS=

# "coming-soon" (default) shows only the pre-launch page; "full" shows the whole site.
SITE_MODE=

# Postgres, two URLs to the same database:
#   DATABASE_POOLED_URL  used by the app at runtime. On Neon: the pooled URL (host contains "-pooler").
#   DATABASE_DIRECT_URL  used only by migrations (run on every build). On Neon: the direct URL.
# Locally, with one Postgres server, set both to the same URL,
# e.g. postgres://postgres@127.0.0.1:5432/bloom
# Unset: sign-ups are kept in memory only (lost on restart), and production builds fail.
DATABASE_POOLED_URL=
DATABASE_DIRECT_URL=

# Address the "Contact us" link emails. Unset: the link shows as plain text.
CONTACT_EMAIL=info@bloom.ng
