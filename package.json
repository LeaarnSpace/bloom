{
  "name": "bloom",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @bloom/adapters-postgres db:generate",
    "db:migrate": "pnpm --filter @bloom/adapters-postgres db:migrate",
    "db:studio": "pnpm --filter @bloom/adapters-postgres db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
